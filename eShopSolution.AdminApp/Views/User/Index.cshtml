@using eShopSolution.ViewModels.Common
@model PageResult<eShopSolution.ViewModels.System.Users.UserViewModel>

@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Notification success or failed -->
@if (TempData["Message"] != null)
{
    var msg = TempData["Message"]?.ToString();
    var isSuccess = TempData["IsSuccess"] as bool? ?? false;
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(msg))",
                duration: 3000,
                gravity: "top",
                position: "right",
                style: {
                    background: "@(isSuccess ? "#28a745" : "#dc3545")",
                    color: "#fff",
                    borderRadius: "8px",
                    boxShadow: "0 3px 10px rgba(0,0,0,0.2)",
                    fontWeight: "500",
                    padding: "12px 18px"
                },
                stopOnFocus: true,
            }).showToast();
        });
    </script>
}

<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Danh sách người dùng</h1>
    <ol class="breadcrumb mb-4" >
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item">Danh sách người dùng</li>
    </ol>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary"><a class="btn btn-success" asp-action="Create" asp-controller="User">Thêm người dùng</a></h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Họ</th>
                            <th>Tên</th>
                            <th>Tài khoản</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th scope="col" colspan="3" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Họ</th>
                            <th>Tên</th>
                            <th>Tài khoản</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th scope="col" colspan="3" class="text-center">Thao tác</th>
                        </tr>
                    </tfoot>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                            <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                            <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                            <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-controller="User" class="btn btn-primary" asp-route-id="@item.Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-controller="User" class="btn btn-primary" asp-route-id="@item.Id">
                                    <i class="fa fa-pen"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <form id="deleteForm" asp-action="Delete" asp-controller="User" method="post" asp-route-id="@item.Id">
                                        <button type="button"
                                                class="btn btn-primary"
                                                onclick="confirmDelete('@item.Id', '@item.UserName')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    <input type="hidden" id="deleteUserId"/>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @await Component.InvokeAsync("Pager", Model)
        </div>
    </div>
</div>