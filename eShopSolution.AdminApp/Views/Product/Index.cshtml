@using eShopSolution.ViewModels.Common
@model PageResult<eShopSolution.ViewModels.Catalog.Products.Dtos.ProductViewModel>
@{
    ViewData["Title"] = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Notification success or failed -->
@if (TempData["Message"] != null)
{
    var msg = TempData["Message"]?.ToString();
    var isSuccess = TempData["IsSuccess"] as bool? ?? false;
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(msg))",
                duration: 3000,
                gravity: "top",
                position: "right",
                style: {
                    background: "@(isSuccess ? "#28a745" : "#dc3545")",
                    color: "#fff",
                    borderRadius: "8px",
                    boxShadow: "0 3px 10px rgba(0,0,0,0.2)",
                    fontWeight: "500",
                    padding: "12px 18px"
                },
                stopOnFocus: true,
            }).showToast();
        });
    </script>
}

<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Danh sách sản phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item">Danh sách sản phẩm</li>
    </ol>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <h6 class="m-0 font-weight-bold text-primary"><a class="btn btn-success" asp-action="Create" asp-controller="Product">Thêm sản phẩm</a></h6>
                </div>
                <div class="col-md-6 col-sm-12">
                    <form asp-action="Index" method="get" class="d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
                        <div class="input-group">
                             <div>
                                 <select name="categoryId" asp-items="@ViewBag.Categories" class="form-control mx-3" onchange="this.form.submit()">
                                    <option value="value">All category</option>
                                </select>
                             </div>
                            <input type="text" name="keyword" class="form-control bg-gray-300 border-0 small" placeholder="Search for..."
                                   aria-label="Search" aria-describedby="basic-addon2" value="@ViewBag.Keyword">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search fa-sm"></i>
                                </button>
                                <button class="btn btn-dark" onclick="window.location.href='/Product/Index'" type="reset">
                                    <i class="fas fa-circle-notch fa-sm"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Tên</th>
                            <th>Giá nhập</th>
                            <th>Giá bán</th>
                            <th>Số lượng tồn</th>
                            <th scope="col" colspan="4" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Tên</th>
                            <th>Giá nhập</th>
                            <th>Giá bán</th>
                            <th>Số lượng tồn</th>
                            <th scope="col" colspan="4" class="text-center">Thao tác</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @if (Model != null && Model.Items != null)
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.OriginalPrice)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-controller="Product" class="btn btn-primary" asp-route-id="@item.Id">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-controller="Product" class="btn btn-primary" asp-route-id="@item.Id">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <form id="deleteForm" asp-action="Delete" asp-controller="Product" method="post" asp-route-id="@item.Id">
                                            <button type="button"
                                                    class="btn btn-primary"
                                                    onclick="confirmDelete('@item.Id', '@item.Name')">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                            <input type="hidden" id="deleteUserId" />
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="CategoryAssign" asp-controller="Product" class="btn btn-primary" asp-route-id="@item.Id">
                                            <i class="fa fa-tags"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <th scope="col" colspan="8" class="text-center font-weight-lighter">Không tồn tại sản phẩm</th>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model != null && Model.Items != null)
                @await Component.InvokeAsync("Pager", Model)
        </div>
    </div>
</div>

